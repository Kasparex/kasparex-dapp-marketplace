{
  "name": "kasparex-hub",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix build",
    "dev": "remix dev",
    "dev:wrangler": "npm run build && wrangler pages dev ./public --port 8788",
    "start": "wrangler pages dev ./public --port 8788",
    "typecheck": "tsc",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "hardhat:compile": "hardhat compile",
    "hardhat:test": "hardhat test",
    "hardhat:deploy": "hardhat run scripts/deploy.js",
    "hardhat:deploy:testnet": "hardhat run scripts/deploy.js --network kasplexL2Testnet",
    "hardhat:deploy:mainnet": "hardhat run scripts/deploy.js --network kasplexL2Mainnet",
    "worker:dev": "cd workers && npm run dev",
    "worker:deploy": "cd workers && npm run deploy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@remix-run/cloudflare": "^2.17.2",
    "@remix-run/cloudflare-pages": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@tanstack/react-query": "^5.81.5",
    "isbot": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.38.6",
    "wagmi": "^2.19.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@remix-run/dev": "^2.17.2",
    "@remix-run/eslint-config": "^2.12.0",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.5",
    "patch-package": "^8.0.1",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vite": "^6.4.1",
    "wrangler": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
