NEXT_PUBLIC_TEMPLATE_CLIENT_ID=...

# Igra Testnet (38836) - Genesis Badge (set after running: npm run hardhat:deploy:genesis-badge)
# NEXT_PUBLIC_GENESIS_BADGE_ADDRESS_IGRA_GALLEON_TESTNET=0x...
# NEXT_PUBLIC_GENESIS_BADGE_ADDRESS_38836=0x...

# Kasparex CrowdKAS (DonationEscrow) - set after deploy + setup-vdonations-auth.js
# NEXT_PUBLIC_DONATION_ESCROW_ADDRESS_38836=0x...
# NEXT_PUBLIC_DONATION_ESCROW_ADDRESS_IGRA_GALLEON_TESTNET=0x...
# Igra Mainnet (38833)
# NEXT_PUBLIC_DONATION_ESCROW_ADDRESS_38833=0x...
# NEXT_PUBLIC_DONATION_ESCROW_ADDRESS_IGRA_MAINNET=0x...
# Optional: listing shows only V2 campaigns when DonationEscrowV2 is configured (hide legacy V1 rows)
# NEXT_PUBLIC_CROWDKAS_HIDE_V1=1
# Optional but recommended for full on-chain rewards plumbing on Igra Mainnet:
# NEXT_PUBLIC_FEE_ROUTER_ADDRESS_IGRA_MAINNET=0x...
# NEXT_PUBLIC_LOYALTY_POINTS_ADDRESS_IGRA_MAINNET=0x...
# L1 record API (backend only): private key of the wallet set as DonationEscrow "recorder" at deploy
# VDONATIONS_RECORDER_PRIVATE_KEY=0x...
# Server-side JSON-RPC for Igra Mainnet (CrowdKAS L2 `recordL1Donation`, module verification reads). Not exposed to the browser.
# IGRA_MAINNET_RPC_URL=https://...
# Optional: platform L1 address for L1 donation fees; Kaspa tx API for verification
# NEXT_PUBLIC_VDONATIONS_PLATFORM_L1_ADDRESS=kaspa:...
# KASPA_TX_API_URL=https://api.kaspa.org
# Optional: kpx reference indexer defaults (REST reads use KASPA_REST_API_URL in src/lib/kaspa/api.ts)
# KPX_INDEX_NET=mainnet
# Optional: comma-separated KRC721 indexer bases (default: krc721-indexer.kaspa.com, then mainnet.krc721.stream)
# KRC721_INDEXER_URLS=https://krc721-indexer.kaspa.com,https://mainnet.krc721.stream
# Programmable tokens (KCC-20): KaspaCom covenant indexer + explorer (kascov fallback in code)
# NEXT_PUBLIC_KCC20_NETWORK=testnet-10
# NEXT_PUBLIC_KASPACOM_INDEXER_BASE=https://tn10-indexer.kaspa.com
# NEXT_PUBLIC_KASPACOM_COVENANT_EXPLORER=https://tn10-covenants.kaspa.com
# NEXT_PUBLIC_KASCOV_BASE=https://kascov-explorer.web.app
# Covenant dApps: hybrid tries wallet L1 (KaspaCom-shaped request), falls back to simulator
# NEXT_PUBLIC_COVENANT_RUNTIME=hybrid
# KPX covenant platform fees (separate from lock principal). Falls back to NEXT_PUBLIC_GAME_TREASURY_ADDRESS.
# NEXT_PUBLIC_COVENANT_LAB_TREASURY=kaspatest:...
# Optional per-template deploy fee in KAS (default: 10 KAS for all covenant templates)
# NEXT_PUBLIC_KPX_COVENANT_DEPLOY_FEE_KAS=10
# NEXT_PUBLIC_KPX_COVENANT_FEE_LOCKBOX_KAS=10
# KPX_INDEX_TX_LIMIT=250
# Optional: Kasparex UI "verified" badge (see /api/kpx/spec `kasparexVerifiedPolicy`). Comma-separated Kaspa addresses; still requires on-chain kpx/ver.
# KPX_VERIFIED_KASPA_ALLOWLIST=kaspa:q...,kaspa:q...

# KREX (Igra Mainnet) - used by tier/discount tooling when enabled in UI
# NEXT_PUBLIC_KREX_ADDRESS_IGRA_MAINNET=0x9C31bB7A012A99dA04AAD94a1CB9176DAF28270D

# --- GRID: canonical L1 + bridged L2 (see docs/GRID_CANONICAL_SUPPLY_MODEL.md) ---
# Canonical GRID is KRC-20 on Kaspa L1 (fixed supply / premint). L2 contracts in this repo are ERC-20 representations.
# Deployed mainnet record: docs/GRID_L1_MAINNET_KRC20_DEPLOYMENT.md
# NEXT_PUBLIC_GRID_KRC20_TICKER=GRID
# NEXT_PUBLIC_GRID_KRC20_TICK_LOWER=grid
# NEXT_PUBLIC_GRID_L1_DEPLOYER_KASPA=kaspa:qzdfxy68rdcwyukrpja0dcc4994p3w49tlermjdvkgnqej77ajhqw6pgxlwfp
# GRID bridged ERC-20 (Katbridge)  -  see docs/GRID_L2_BRIDGED_KATBRIDGE_DEPLOYMENT.md
# Kasplex L2 mainnet (chain 202555)
# NEXT_PUBLIC_GRID_TOKEN_ADDRESS_KASPLEX_L2=0x9396eDf77EcA8087DDE39121e7A15ABfB8784570
# Igra L2 mainnet (chain 38833)
# NEXT_PUBLIC_GRID_TOKEN_ADDRESS_IGRA_MAINNET=0x05E02a8b14CD7974c6102CDB855F2dCd8E1f4902
# NEXT_PUBLIC_GRID_TOKEN_ADDRESS_IGRA_GALLEON_TESTNET=0x...
