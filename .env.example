NEXT_PUBLIC_TEMPLATE_CLIENT_ID=...

# IGRA Galleon Testnet (38836) - Genesis Badge (set after running: npm run hardhat:deploy:genesis-badge)
# NEXT_PUBLIC_GENESIS_BADGE_ADDRESS_IGRA_GALLEON_TESTNET=0x...
# NEXT_PUBLIC_GENESIS_BADGE_ADDRESS_38836=0x...

# vDonations (DonationEscrow) - set after deploy + setup-vdonations-auth.js
# NEXT_PUBLIC_DONATION_ESCROW_ADDRESS_38836=0x...
# NEXT_PUBLIC_DONATION_ESCROW_ADDRESS_IGRA_GALLEON_TESTNET=0x...
# L1 record API (backend only): private key of the wallet set as DonationEscrow "recorder" at deploy
# VDONATIONS_RECORDER_PRIVATE_KEY=0x...
# Optional: platform L1 address for L1 donation fees; Kaspa tx API for verification
# NEXT_PUBLIC_VDONATIONS_PLATFORM_L1_ADDRESS=kaspa:...
# KASPA_TX_API_URL=https://api.kaspa.org
