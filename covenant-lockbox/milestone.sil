// Staged milestone release reference.

pragma silverscript ^0.1.0;

contract KasparexMilestone() {
    int released_step = 0;

    #[covenant.singleton(mode = transition)]
    function release_next(
        State prev_state,
        int step_index,
        sig beneficiary_sig,
        pubkey beneficiary_pk
    ) : (State) {
        require(step_index == prev_state.released_step + 1);
        require(checkSig(beneficiary_sig, beneficiary_pk));
        return { released_step: step_index };
    }
}
