// Kasparex Covenant Lab lockbox (escrow / timelock).

pragma silverscript ^0.1.0;

contract KasparexLockbox() {
    int unlock_at = 0;

    #[covenant.singleton(mode = transition, termination = allowed)]
    function claim(
        State prev_state,
        sig beneficiary_sig,
        pubkey beneficiary
    ) : (State[]) {
        require(checkSig(beneficiary_sig, beneficiary));
        if (prev_state.unlock_at > 0) {
            require(tx.time >= prev_state.unlock_at);
        }
        return [];
    }
}
