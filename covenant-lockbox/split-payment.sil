// Kasparex 1:N split payment (fan-out verification reference).

pragma silverscript ^0.1.0;

contract KasparexSplitPayment() {
    #[covenant(binding = auth, from = 1, to = 8, mode = verification, groups = multiple)]
    function distribute(sig payer_sig, pubkey payer_pk) {
        require(checkSig(payer_sig, payer_pk));
    }
}
