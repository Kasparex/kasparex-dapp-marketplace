// Hashlock voucher reference.

pragma silverscript ^0.1.0;

contract KasparexVoucher() {
    #[covenant(binding = auth, from = 1, to = 1, mode = verification, termination = allowed)]
    function redeem(
        byte[] preimage,
        sig claimer_sig,
        pubkey claimer_pk,
        byte[32] secret_hash
    ) {
        require(sha256(preimage) == secret_hash);
        require(checkSig(claimer_sig, claimer_pk));
    }
}
