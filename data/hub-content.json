        "roadmap": [
          {
            "date": "Phase 1 - Q2 2026",
            "title": "Foundation & Deployment",
            "description": "<p>Launch GRID as the official canonical ecosystem reward token of Kasparex with L1 foundation and L2 operational support.</p><h2>Goals</h2><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Deploy canonical GRID on Kaspa KRC-20</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Set max supply to 10B GRID</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Premint 100% of supply</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Establish GRID as global reward token</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Prepare treasury structure for future distribution</li></ol>",
            "status": "completed"
          },
          {
            "date": "Phase 2 - Q2–Q3 2026",
            "title": "L2 Onboarding & Network Integration",
            "description": "<p>Integrate GRID with major Kaspa L2 environments to enable smart contract utility and cross-network reward distribution.</p><h2>Goals</h2><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Onboard GRID to Kasplex L2</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Onboard GRID to Igra L2</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Enable L2 wallet support</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Connect reward tracking across networks</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Build unified multi-network GRID accounting</li></ol>",
            "status": "in-progress"
          },
          {
            "date": "Phase 3 - Q3 2026",
            "title": "Reward Engine Launch",
            "description": "<p>Launch the first version of the GRID reward engine powering ecosystem-wide reward distribution.</p><h2>Goals</h2><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Activate reward calculator</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Launch dynamic reward multipliers</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Enable KREX tier boosts</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Enable NFT-based reward boosts</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Introduce seasonal reward bonuses</li></ol>",
            "status": "upcoming"
          },
          {
            "date": "Phase 4 - Q3–Q4 2026",
            "title": "Dapp Reward Integration",
            "description": "<p>Expand GRID utility across Kasparex dApps and core ecosystem tools.</p><h2>Goals</h2><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Reward dApp activity with GRID</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Reward engagement actions</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Reward content creation</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Reward ecosystem participation</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Add cross-dApp reward tracking</li></ol>",
            "status": "upcoming"
          },
          {
            "date": "Phase 5 - Q4 2026",
            "title": "Gaming Rewards & Quests",
            "description": "<p>Bring GRID into games, quests, missions, and interactive engagement systems.</p><h2>Goals</h2><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Launch GRID game rewards</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Daily quests and challenges</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Seasonal events</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Competitive leaderboards</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Special event bonuses</li></ol>",
            "status": "upcoming"
          },
          {
            "date": "Phase 6 - Q4 2026 - Q1 2027",
            "title": "Node Rewards & Infrastructure Incentives",
            "description": "<p>Reward infrastructure contributors and node operators supporting the ecosystem.</p><h2>Goals</h2><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Reward GRID node operators</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Reward infrastructure contributors</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Incentivize uptime and reliability</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Create validator incentive programs</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Strengthen network activity</li></ol>",
            "status": "upcoming"
          },
          {
            "date": "Phase 7 - Q1 2027",
            "title": "Utility & Token Sinks",
            "description": "<p>Introduce powerful utility and token sink mechanisms to strengthen GRID demand and ecosystem sustainability.</p><h2>Goals</h2><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Premium dApp unlocks</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Feature access payments</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Boost activations</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>NFT upgrades</li><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span>Burn mechanics for perks</li></ol>",
            "status": "upcoming"
          }
