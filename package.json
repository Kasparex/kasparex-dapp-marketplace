  "dependencies": {
    "@kluster/kaspa-address": "^0.1.5",
    "@kluster/kaspa-auth": "^0.0.2",
    "@kluster/kaspa-signature": "^0.1.5",
    "@openzeppelin/contracts": "^5.4.0",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@tanstack/react-query": "^5.81.5",
    "next": "15.4.10",
    "quill": "^2.0.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-quill": "^2.0.0",
    "viem": "^2.38.6",
    "wagmi": "^2.19.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.4.3",
    "@typechain/hardhat": "^8.0.3",
    "@types/node": "^20",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "15.4.10",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.5",
    "ignore-loader": "^0.1.2",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.2",
    "typechain": "^8.3.2",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.7"
    }
  }
}
