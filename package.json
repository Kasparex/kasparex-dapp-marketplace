{
  "name": "kasparex-connect-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "hardhat:compile": "hardhat compile",
    "hardhat:test": "hardhat test",
    "hardhat:deploy": "hardhat run scripts/deploy.js",
    "hardhat:deploy:testnet": "hardhat run scripts/deploy.js --network kasplexL2Testnet",
    "hardhat:deploy:mainnet": "hardhat run scripts/deploy.js --network kasplexL2Mainnet",
    "hardhat:deploy:ecosystem:testnet": "hardhat run scripts/deploy-ecosystem.js --network kasplexL2Testnet",
    "hardhat:deploy:ecosystem:mainnet": "hardhat run scripts/deploy-ecosystem.js --network kasplexL2Mainnet",
    "hardhat:deploy:dapp:testnet": "hardhat run scripts/deploy-dapp-with-token.js --network kasplexL2Testnet",
    "hardhat:deploy:dapp:mainnet": "hardhat run scripts/deploy-dapp-with-token.js --network kasplexL2Mainnet",
    "hardhat:configure:rewards": "hardhat run scripts/configure-rewards.js --network kasplexL2Testnet",
    "hardhat:configure:rewards:mainnet": "hardhat run scripts/configure-rewards.js --network kasplexL2Mainnet",
    "hardhat:setup:default:rewards": "hardhat run scripts/setup-default-rewards.js --network kasplexL2Testnet",
    "hardhat:configure:all:grid": "hardhat run scripts/configure-all-dapps-grid.js --network kasplexL2Testnet",
    "hardhat:transfer:grid": "hardhat run scripts/transfer-grid-to-reward-manager.js --network kasplexL2Testnet",
    "hardhat:transfer:grid:mainnet": "hardhat run scripts/transfer-grid-to-reward-manager.js --network kasplexL2Mainnet",
    "hardhat:test:ecosystem": "hardhat run scripts/test-ecosystem.js --network kasplexL2Testnet",
    "hardhat:configure": "hardhat run scripts/configure-treasury.js",
    "hardhat:verify": "hardhat run scripts/verify-contracts.js",
    "hardhat:verify:testnet": "hardhat run scripts/verify-contracts.js --network kasplexL2Testnet",
    "hardhat:verify:mainnet": "hardhat run scripts/verify-contracts.js --network kasplexL2Mainnet",
    "hardhat:deploy:promo-router": "hardhat run scripts/deploy-promo-router.js --network igraCaravelTestnet",
    "hardhat:deploy:test-token": "hardhat run scripts/deploy-test-token.js --network igraCaravelTestnet",
    "hardhat:register:promo-token": "hardhat run scripts/register-promo-token.js --network igraCaravelTestnet",
    "hardhat:setup:promo-token": "hardhat run scripts/setup-promo-token.js --network igraCaravelTestnet",
    "hardhat:update:mint-price": "hardhat run scripts/update-mint-price.js --network igraCaravelTestnet",
    "gitbook:setup": "node scripts/gitbook-sync/cli.js setup",
    "gitbook:sync": "node scripts/gitbook-sync/cli.js sync",
    "gitbook:test": "node scripts/gitbook-sync/cli.js test",
    "gitbook:listen": "node scripts/gitbook-sync/listener.js",
    "gitbook:generate": "node scripts/gitbook-sync/generate-markdown.js",
    "gitbook:sync:git": "node scripts/gitbook-sync/sync-to-git.js",
    "upload:assets": "tsx scripts/upload-assets-to-ipfs.ts",
    "upload:assets:dry": "tsx scripts/upload-assets-to-ipfs.ts --dry-run",
    "upload:registry": "tsx scripts/upload-registry-to-ipfs.ts",
    "upload:traits": "tsx scripts/upload-trait-images-to-ipfs.ts",
    "upload:traits:dry": "tsx scripts/upload-trait-images-to-ipfs.ts --dry-run",
    "rename:hats": "node scripts/rename-hat-files-auto.js",
    "worker:dev": "cd workers && npm run dev",
    "worker:deploy": "cd workers && npm run deploy",
    "worker:deploy:production": "cd workers && npm run deploy:production"
